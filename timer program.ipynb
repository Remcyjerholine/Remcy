   "source": [
    "import time\n",
    "my_time=int(input(\"enter the time in seconds:\"))\n",
    "for x in range(my_time,0,-1):\n",
    "    seconds=x%60\n",
    "    minutes=int(x/60)%60\n",
    "    hours=int(x/3600)\n",
    "    print(f\"{hours:02}:{minutes:02}:{seconds:02}\")\n",
    "    time.sleep(1)\n",
    "print(\"TIMES UP\")    "
   ]
